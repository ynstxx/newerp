# 服务
NODE_ENV=development
HOST=0.0.0.0
PORT=8080

# 生产必填：会话签名与人机校验的 HMAC 密钥（openssl rand -hex 32）
# NODE_ENV=production 时未设置会拒绝启动
APP_SECRET=

# 数据库（双库等权，切 DB_DRIVER 即可；默认端口见 docker-compose.yml 映射）
DB_DRIVER=pg
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=newerp
DB_PASSWORD=newerp
DB_NAME=newerp

# 切 MySQL 时用下面这组（profile: mysql）
# DB_DRIVER=mysql
# DB_PORT=3308
